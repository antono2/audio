#!/usr/bin/env -S v run

import os

const project_root = @VMODROOT

fn main() {
	build() or {
		eprintln('native audio build failed: ${err}')
		exit(1)
	}
}

fn build() ! {
	output_dir := os.join_path(project_root, '.cache', 'native')
	staging_dir := os.join_path(output_dir, '.audio-build-${os.getpid()}')
	os.mkdir_all(staging_dir)!
	defer {
		if os.exists(staging_dir) {
			os.rmdir_all(staging_dir) or {}
		}
	}
	cc := tool_from_environment('ANTONO2_AUDIO_CC', 'cc')
	ar := tool_from_environment('ANTONO2_AUDIO_AR', 'ar')
	miniaudio_dir := os.join_path(project_root, 'thirdparty', 'miniaudio')
	vorbis_dir := os.join_path(project_root, 'thirdparty', 'stb_vorbis')
	miniaudio_source := os.join_path(staging_dir, 'miniaudio_impl.c')
	vorbis_source := os.join_path(vorbis_dir, 'stb_vorbis.c')
	miniaudio_object := os.join_path(staging_dir, 'miniaudio_impl.o')
	vorbis_object := os.join_path(staging_dir, 'stb_vorbis.o')
	staged_library := os.join_path(staging_dir, 'libantono2_audio.a')
	os.write_file(miniaudio_source, miniaudio_build_unit())!
	compile(cc, miniaudio_source, miniaudio_object, [miniaudio_dir, vorbis_dir])!
	compile(cc, vorbis_source, vorbis_object, [vorbis_dir])!
	run('${os.quoted_path(ar)} rcs ${os.quoted_path(staged_library)} ${os.quoted_path(miniaudio_object)} ${os.quoted_path(vorbis_object)}')!
	final_library := os.join_path(output_dir, 'libantono2_audio.a')
	os.mv(staged_library, final_library)!
	println(final_library)
}

fn miniaudio_build_unit() string {
	return '/* Generated by scripts/build_native_audio.vsh; do not edit. */\n' + '#define MA_NO_ENCODING\n' + '#define MA_NO_FLAC\n' + '#define MA_NO_MP3\n' + '#define MA_NO_GENERATION\n' + '#include "stb_vorbis.h"\n' + '#define MINIAUDIO_IMPLEMENTATION\n' + '#include "miniaudio.h"\n'
}

fn compile(cc string, source string, output string, include_dirs []string) ! {
	mut command := '${os.quoted_path(cc)} -std=c99 -O2'
	for include_dir in include_dirs {
		command += ' -I ${os.quoted_path(include_dir)}'
	}
	command += ' -c ${os.quoted_path(source)} -o ${os.quoted_path(output)}'
	run(command)!
}

fn tool_from_environment(name string, fallback string) string {
	configured := os.getenv(name)
	if configured != '' {
		return configured
	}
	return fallback
}

fn run(command string) ! {
	result := os.execute(command)
	if result.output != '' {
		print(result.output)
	}
	if result.exit_code != 0 {
		return error('`${command}` exited with ${result.exit_code}')
	}
}
